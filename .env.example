# Dev: leave VITE_API_BASE_URL unset — Vite proxy handles /api, /media, /ws on http://localhost:5173

VITE_API_PORT=8000



# Only if you skip the Vite proxy (direct HTTP backend, mic works on localhost only):
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend URL for Vite proxy (default http://127.0.0.1:8000)

VITE_API_PROXY_TARGET=http://127.0.0.1:8000


